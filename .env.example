# =============================================================================
# Présenz — environment variables
# Copy to `.env` for local dev. Add the same keys in Vercel (per-environment)
# for Preview and Production.
# =============================================================================

# --- REQUIRED in every environment -------------------------------------------

# Postgres connection string. For Vercel, use Vercel Postgres / Neon /
# Supabase / Railway. Format: postgresql://USER:PASS@HOST:PORT/DB?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/presenz?schema=public"

# NextAuth signing secret. Generate with: openssl rand -base64 32
# A different value per environment is fine; sessions just won't carry across.
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# The canonical URL for this deployment.
# Local:    http://localhost:3000
# Vercel:   https://your-domain.com  (or the Vercel-generated URL)
# On Vercel you can omit this — VERCEL_URL is auto-injected — but setting it
# explicitly to your custom domain prevents callback-URL issues.
NEXTAUTH_URL="http://localhost:3000"


# --- OPTIONAL: leave blank to use the dev stub --------------------------------
# Each block below activates the live integration the moment the keys are set.
# In dev with all of these blank, OTPs print to the server console, Aadhaar
# returns success after a short delay, the face scan returns a high match
# score, NSFW always passes, and uploads land in /public/uploads/.

# Twilio — phone OTP delivery
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""        # E.164, e.g. +14155552671

# DigiLocker / UIDAI — Aadhaar verification
# Live integrations are typically through Karza, Signzy, Hyperverge, or
# direct DigiLocker partner access.
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""

# AWS Rekognition — face liveness + photo match
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Cloudinary — profile photo storage
# In dev with these blank, photos are written to /public/uploads/ on disk.
# That works locally but DOES NOT survive a Vercel deploy (read-only fs),
# so set these before deploying with real photo flows.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Cloud Vision — SafeSearch image moderation
GOOGLE_VISION_API_KEY=""

# Razorpay subscriptions (Phase 4).
# After setting the four vars below, run POST /api/admin/razorpay/setup-plans
# once (admin only) to create PLUS + CONCIERGE Plan objects and populate the
# RazorpayPlan table. NEXT_PUBLIC_RAZORPAY_KEY_ID and RAZORPAY_KEY_ID hold the
# same key_id — the public one is exposed to the browser checkout.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""


# --- ADVANCED -----------------------------------------------------------------

# Set automatically by Vercel — listed here for reference only.
# VERCEL_URL=""
# VERCEL_ENV="production" | "preview" | "development"
NODE_ENV="development"
