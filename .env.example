# Database
DATABASE_URL="postgresql://user:password@localhost:5432/presenz?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Twilio (phone OTP) — leave blank in dev, OTP is logged to console
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# UIDAI / DigiLocker (Aadhaar) — stubbed in dev
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""

# AWS Rekognition (face liveness + match) — stubbed in dev
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Cloudinary (image upload) — stubbed to /public/uploads in dev
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Vision (NSFW moderation) — stubbed in dev
GOOGLE_VISION_API_KEY=""

# Mode flag
NODE_ENV="development"
